<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}</title>
<style>
{% raw %}
:root {
  --bg: #0f1117;
  --panel: #171a21;
  --panel-2: #1e222b;
  --border: #2a2f3a;
  --text: #e6e8ee;
  --muted: #9aa3b2;
  --accent: #e37400;
  --accent-2: #ff8c1a;
  --ok: #37b24d;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.5;
}
.container { max-width: 1080px; margin: 0 auto; padding: 32px 20px 80px; }
header h1 { margin: 0 0 4px; font-size: 26px; }
header p { margin: 0 0 24px; color: var(--muted); }
.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 20px;
}
.section-title {
  padding: 12px 18px;
  font-weight: 600;
  font-size: 15px;
  background: var(--panel-2);
  border-bottom: 1px solid var(--border);
}
.row {
  display: grid;
  grid-template-columns: 220px 1fr;
  align-items: center;
  border-bottom: 1px solid var(--border);
}
.row:last-child { border-bottom: none; }
.row-label {
  padding: 12px 18px;
  font-size: 14px;
  color: var(--text);
}
.row-label .desc { display: block; color: var(--muted); font-size: 12px; font-weight: 400; margin-top: 2px; }
.row-value { padding: 8px 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.cell {
  border: 1px solid var(--border);
  background: var(--panel-2);
  color: var(--text);
  border-radius: 8px;
  padding: 6px 14px;
  font-size: 13px;
  cursor: pointer;
  user-select: none;
  transition: all .12s ease;
}
.cell:hover { border-color: var(--accent-2); }
.cell.selected {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  font-weight: 600;
}
input[type="text"], input[type="number"], textarea, select {
  background: var(--panel-2);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 8px;
  padding: 7px 10px;
  font-size: 13px;
  font-family: inherit;
  min-width: 260px;
}
textarea { min-width: 420px; min-height: 60px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
select { min-width: 320px; }
.hidden { display: none !important; }
.inactive { opacity: .4; }
.command-card {
  position: sticky;
  bottom: 0;
  background: var(--panel);
  border: 1px solid var(--accent);
  border-radius: 12px;
  margin-top: 28px;
}
.command-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12px 18px; border-bottom: 1px solid var(--border);
}
.command-head span { font-weight: 600; }
.copy-btn {
  border: 1px solid var(--accent);
  background: var(--accent);
  color: #fff;
  border-radius: 8px;
  padding: 6px 16px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
}
.copy-btn.copied { background: var(--ok); border-color: var(--ok); }
pre.command {
  margin: 0;
  padding: 18px;
  overflow-x: auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
  color: #d7f0ff;
  white-space: pre-wrap;
  word-break: break-word;
}
.error { color: #ff6b6b; font-size: 12px; }
.footer { color: var(--muted); font-size: 12px; margin-top: 24px; text-align: center; }
{% endraw %}
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>{{ title }}</h1>
    <p>Pick your setup below. The install &amp; run command updates live &mdash; copy it and go.</p>
  </header>

  <div id="picker"></div>

  <div class="command-card">
    <div class="command-head">
      <span>Command</span>
      <button id="copy-btn" class="copy-btn">Copy</button>
    </div>
    <pre id="command" class="command"></pre>
    <div id="json-error" class="error" style="padding: 0 18px 12px;"></div>
  </div>

  <div class="footer">Generated by <code>madengine setup-page</code>.</div>
</div>

<script id="madengine-data" type="application/json">{{ data_json }}</script>
<script>
{% raw %}
(function () {
  "use strict";

  var DATA = JSON.parse(document.getElementById("madengine-data").textContent);
  var MODELS = DATA.models || [];
  var SCHEMA = DATA.schema || [];
  var SECTIONS = DATA.sections || [];
  var WORKLOADS = DATA.workloads || [];
  var REPO_URL = DATA.repoUrl || "";
  var INSTALL_CMD = DATA.installCmd || "pip install git+https://github.com/ROCm/madengine.git";

  // Runtime selection state.
  var state = {
    target: "local",          // local | k8s | slurm
    tag: MODELS.length ? MODELS[0].name : "",
    workload: WORKLOADS.length ? WORKLOADS[0].id : "default",
    values: {}                // schema key -> string value
  };

  var picker = document.getElementById("picker");
  var commandEl = document.getElementById("command");
  var errorEl = document.getElementById("json-error");

  function repoName() {
    if (!REPO_URL) return "";
    var parts = REPO_URL.replace(/\/+$/, "").split("/");
    return parts[parts.length - 1].replace(/\.git$/, "");
  }

  // Whether a schema entry is active given the current deployment target.
  function isActive(entry) {
    var scope = entry.deploy_scope;
    if (scope === "always") return true;
    if (scope === "local" || scope === "k8s" || scope === "slurm") {
      return state.target === scope;
    }
    if (scope === "distributed") {
      return !!state.values["distributed.launcher"];
    }
    return true;
  }

  function setValue(key, val) {
    state.values[key] = val;
    render();
  }

  function makeCell(label, selected, onClick) {
    var el = document.createElement("div");
    el.className = "cell" + (selected ? " selected" : "");
    el.textContent = label;
    el.addEventListener("click", onClick);
    return el;
  }

  // Build one row for a schema entry.
  function renderEntryRow(entry) {
    var row = document.createElement("div");
    row.className = "row" + (isActive(entry) ? "" : " inactive");

    var label = document.createElement("div");
    label.className = "row-label";
    label.innerHTML = entry.label + '<span class="desc">' + entry.description + "</span>";
    row.appendChild(label);

    var value = document.createElement("div");
    value.className = "row-value";

    var current = state.values[entry.key] !== undefined
      ? state.values[entry.key]
      : (entry.default || "");
    if (state.values[entry.key] === undefined && entry.default) {
      state.values[entry.key] = entry.default;
    }

    if (entry.type === "enum" || entry.type === "bool") {
      var choices = entry.type === "bool" ? ["true", "false"] : entry.choices;
      choices.forEach(function (choice) {
        var selected = current === choice;
        value.appendChild(makeCell(choice, selected, function () {
          // Allow deselect only when there is no default.
          if (selected && !entry.default) {
            setValue(entry.key, "");
          } else {
            setValue(entry.key, choice);
          }
        }));
      });
    } else if (entry.type === "json") {
      var ta = document.createElement("textarea");
      ta.value = current;
      ta.placeholder = entry.description;
      ta.addEventListener("input", function () {
        state.values[entry.key] = ta.value;
        buildCommand();
      });
      value.appendChild(ta);
    } else {
      var input = document.createElement("input");
      input.type = entry.type === "int" ? "number" : "text";
      input.value = current;
      input.placeholder = entry.description;
      input.addEventListener("input", function () {
        state.values[entry.key] = input.value;
        buildCommand();
      });
      value.appendChild(input);
    }

    row.appendChild(value);
    return row;
  }

  // Special model + deployment-target rows at the top.
  function renderTopCard() {
    var card = document.createElement("div");
    card.className = "card";

    var title = document.createElement("div");
    title.className = "section-title";
    title.textContent = "Model";
    card.appendChild(title);

    // Model selector.
    var modelRow = document.createElement("div");
    modelRow.className = "row";
    var mLabel = document.createElement("div");
    mLabel.className = "row-label";
    mLabel.innerHTML = 'Model / tag<span class="desc">Model to run (passed to --tags).</span>';
    modelRow.appendChild(mLabel);
    var mVal = document.createElement("div");
    mVal.className = "row-value";
    if (MODELS.length) {
      var sel = document.createElement("select");
      MODELS.forEach(function (m) {
        var opt = document.createElement("option");
        opt.value = m.name;
        var tags = (m.tags && m.tags.length) ? "  [" + m.tags.join(", ") + "]" : "";
        opt.textContent = m.name + tags;
        if (m.name === state.tag) opt.selected = true;
        sel.appendChild(opt);
      });
      sel.addEventListener("change", function () {
        state.tag = sel.value;
        buildCommand();
      });
      mVal.appendChild(sel);
    }
    var tagInput = document.createElement("input");
    tagInput.type = "text";
    tagInput.placeholder = "or a custom tag";
    tagInput.value = MODELS.length ? "" : state.tag;
    tagInput.addEventListener("input", function () {
      if (tagInput.value) state.tag = tagInput.value;
      else if (MODELS.length) state.tag = MODELS[0].name;
      buildCommand();
    });
    mVal.appendChild(tagInput);
    modelRow.appendChild(mVal);
    card.appendChild(modelRow);

    // Workload selector (real-world use case: train/inference/finetune/serve).
    if (WORKLOADS.length) {
      var wRow = document.createElement("div");
      wRow.className = "row";
      var wLabel = document.createElement("div");
      wLabel.className = "row-label";
      var wDesc = "";
      WORKLOADS.forEach(function (w) {
        if (w.id === state.workload) wDesc = w.description || "";
      });
      wLabel.innerHTML = 'Workload<span class="desc">' + wDesc + "</span>";
      wRow.appendChild(wLabel);
      var wVal = document.createElement("div");
      wVal.className = "row-value";
      WORKLOADS.forEach(function (w) {
        wVal.appendChild(makeCell(w.label, state.workload === w.id, function () {
          state.workload = w.id;
          render();
        }));
      });
      wRow.appendChild(wVal);
      card.appendChild(wRow);
    }

    // Deployment target selector.
    var tRow = document.createElement("div");
    tRow.className = "row";
    var tLabel = document.createElement("div");
    tLabel.className = "row-label";
    tLabel.innerHTML = 'Deployment target<span class="desc">Where the model runs. Inferred from context keys.</span>';
    tRow.appendChild(tLabel);
    var tVal = document.createElement("div");
    tVal.className = "row-value";
    ["local", "k8s", "slurm"].forEach(function (t) {
      tVal.appendChild(makeCell(t, state.target === t, function () {
        state.target = t;
        render();
      }));
    });
    tRow.appendChild(tVal);
    card.appendChild(tRow);

    return card;
  }

  function render() {
    picker.innerHTML = "";
    picker.appendChild(renderTopCard());

    SECTIONS.forEach(function (section) {
      if (section.id === "deploy") return; // handled in top card
      var entries = SCHEMA.filter(function (e) { return e.section === section.id; });
      if (!entries.length) return;

      // Hide k8s/slurm sections that don't match the selected target.
      if ((section.id === "k8s" && state.target !== "k8s") ||
          (section.id === "slurm" && state.target !== "slurm")) {
        return;
      }

      var card = document.createElement("div");
      card.className = "card";
      var title = document.createElement("div");
      title.className = "section-title";
      title.textContent = section.label;
      card.appendChild(title);
      entries.forEach(function (entry) {
        card.appendChild(renderEntryRow(entry));
      });
      picker.appendChild(card);
    });

    buildCommand();
  }

  // Assign a dotted key path into a nested object.
  function assignNested(obj, dottedKey, val) {
    var parts = dottedKey.split(".");
    var cur = obj;
    for (var i = 0; i < parts.length - 1; i++) {
      if (typeof cur[parts[i]] !== "object" || cur[parts[i]] === null) {
        cur[parts[i]] = {};
      }
      cur = cur[parts[i]];
    }
    cur[parts[parts.length - 1]] = val;
  }

  function coerce(entry, raw) {
    if (entry.type === "int") {
      var n = Number(raw);
      return isNaN(n) ? raw : n;
    }
    if (entry.type === "bool") {
      return raw === "true";
    }
    if (entry.type === "json") {
      return JSON.parse(raw); // may throw
    }
    return raw;
  }

  function buildCommand() {
    errorEl.textContent = "";
    var context = {};
    var flags = [];
    var jsonError = null;

    SCHEMA.forEach(function (entry) {
      if (!isActive(entry)) return;
      var raw = state.values[entry.key];
      if (raw === undefined || raw === "" || raw === null) return;
      if (raw === (entry.default || "")) return; // omit default/unset values

      if (entry.flag) {
        if (entry.type === "bool") {
          if (raw === "true") flags.push(entry.flag);
        } else {
          flags.push(entry.flag + " " + quoteArg(raw));
        }
        return;
      }

      var val;
      try {
        val = coerce(entry, raw);
      } catch (e) {
        jsonError = 'Invalid JSON for "' + entry.label + '": ' + e.message;
        return;
      }
      assignNested(context, entry.key, val);
    });

    if (jsonError) {
      errorEl.textContent = jsonError;
    }

    // Apply the selected workload via the agnostic entrypoint wrapper.
    WORKLOADS.forEach(function (w) {
      if (w.id === state.workload && w.encapsulate) {
        context.encapsulate_script = w.encapsulate;
      }
    });

    var lines = [];
    lines.push("# 1. Install madengine");
    lines.push(INSTALL_CMD);
    if (REPO_URL) {
      lines.push("");
      lines.push("# 2. Get the model repo");
      lines.push("git clone " + REPO_URL + ".git");
      lines.push("cd " + repoName());
      lines.push("");
      lines.push("# 3. Run the model");
    } else {
      lines.push("");
      lines.push("# 2. Run the model (from your models.json repo)");
    }

    var run = "madengine run --tags " + quoteArg(state.tag || "<model>");
    if (Object.keys(context).length) {
      run += " --additional-context '" + JSON.stringify(context) + "'";
    }
    if (flags.length) {
      run += " " + flags.join(" ");
    }
    lines.push(run);

    commandEl.textContent = lines.join("\n");
  }

  function quoteArg(v) {
    var s = String(v);
    return /[\s"']/.test(s) ? '"' + s.replace(/"/g, '\\"') + '"' : s;
  }

  document.getElementById("copy-btn").addEventListener("click", function () {
    var btn = this;
    navigator.clipboard.writeText(commandEl.textContent).then(function () {
      btn.textContent = "Copied!";
      btn.classList.add("copied");
      setTimeout(function () {
        btn.textContent = "Copy";
        btn.classList.remove("copied");
      }, 1500);
    });
  });

  render();
})();
{% endraw %}
</script>
</body>
</html>
